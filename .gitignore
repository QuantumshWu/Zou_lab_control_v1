# Python cache and build outputs
__pycache__/
*.py[cod]
*.pyc.*
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
build/
dist/
pip-wheel-metadata/
*.egg-info/
*.egg

# Virtual environments and local env files
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example
.zlc_python_path

# Jupyter
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*-checkpoint.ipynb
**/*-checkpoint.ipynb
tutorials/_executed_check/
**/_executed_check/

# Generated local outputs.  The composition root receives an explicit runtime
# workspace; operator-facing exports use the repository-local _output default.
# Ignore that single local product tree, never source documents.
/_output/
**/_output/

# Figures + data dumps are NEVER committed: panel/Figure exports live below
# _output/figures while tasks/ contains only reloadable layout JSON source,
# calibration reports, scan exports, scratch captures.  The only binary assets admitted
# to git are deliverable manual figures and explicitly named independent test oracles.
# (Saved task LAYOUTS tasks/*.json are not data, so they stay committable.)
*.png
*.npz
*.npy
!docs/**/assets/*.png
!tests/fixtures/main_readout_oracle.npz
_shots/
**/_shots/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
~$*
tmp/
temp/

# OS and editor metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# LaTeX auxiliary files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.out
*.run.xml
*.synctex.gz
*.toc
*.build.log
docs/**/*_zh.txt
# Manual sources are build intermediates: only the PDF (+ assets/) belongs in
# docs/.  The real source is the .texbody templates + the build_* functions;
# render_notes_pdf compiles in a temp dir and copies back ONLY the .pdf.
docs/**/*.tex
docs/**/*.sty

# Vivado / FPGA generated working files
.Xil/
*.jou
*.wdb
*.str
*.rpt
*.dcp
*.ltx
*.runs/
*.cache/
*.hw/
*.sim/

# Scratch GUI verification screenshots (devtools output, not deliverables)
/_gui_shots/
/.gui-evidence/
/.gui_evidence/

# Pulse presets (pulses/): checked-in PulseDocument authoring JSON is committable.
# Ignore only scratch files, unnamed timestamp saves, and local real-machine debug programs.
pulses/_test_*
pulses/pulse_[0-9]*.json
pulses/T.json
pulses/T2.json
pulses/pulse_test.json

# xsim litter (simulation runs anywhere in the tree)
xsim.dir/
*.pb
calibrations/

# Claude/Codex session state belongs outside the repository.
/.claude/
