# Auto detect text files and perform LF normalization
* text=auto

# Windows batch files MUST be CRLF in the working tree, otherwise cmd.exe fails
# to seek :labels ("The system cannot find the batch label specified ...").
*.bat text eol=crlf
*.cmd text eol=crlf

# zlc_geometry.vh is generated by image.emit_geometry_vh (joins with '\n'); pin its eol so a
# regenerate on a LF platform (Linux CI) does not produce a whitespace-only diff against the copy.
fpga/pulse_streamer/zlc_geometry.vh text eol=lf
